@namespace CommonLibraryP.SecsGemPKG.Component
@rendermode RenderMode.InteractiveServer

@inject SecsGemService secsGemService
@inject NotificationService notificationService

<div class="card h-100">
    <EditForm Model="@sendEventParameter" Context="EditFormContext" OnValidSubmit="SendEvent">
        <DataAnnotationsValidator />
        <DxFormLayout>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="SV Name" ColSpanLg="6" BeginRow="true">
                <DxSpinEdit @bind-Value="@sendEventParameter.EventId" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="12">
                <hr />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                <DxToolbar>
                    <Items>
                        <DxToolbarItem IconCssClass="oi oi-check" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Primary" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />
                    </Items>
                </DxToolbar>
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditForm>

</div>

@code {
    private SendEventParameter sendEventParameter { get; set; } = null!;

    protected override Task OnInitializedAsync()
    {
        sendEventParameter = new();
        return base.OnInitializedAsync();
    }

    private async Task SendEvent()
    {
        var res = await secsGemService.SendEvent(sendEventParameter);
        notificationService.ShowToast(res);
    }
}
