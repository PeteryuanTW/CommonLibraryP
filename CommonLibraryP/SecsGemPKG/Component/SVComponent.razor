@namespace CommonLibraryP.SecsGemPKG.Component
@rendermode RenderMode.InteractiveServer

@implements IDisposable
@inject SecsGemService secsGemService

<DxGrid @ref="@grid" Data="@svList" @bind-SelectedDataItem="@targetSVObj" DataItemDeleting="DeleteSV" AllowSelectRowByClick="true" SelectionMode="GridSelectionMode.Single" HighlightRowOnHover="true">
    <ToolbarTemplate>
        @if (ShowToolBar)
        {
            <DxToolbar Title="@(targetSV?.Name)" SizeMode="SizeMode.Large" ItemRenderStyleMode="ToolbarRenderStyleMode.Contained">
                <DxToolbarItem IconCssClass="oi oi-plus" Click="NewSVClicked" BeginGroup="true" />
                <DxToolbarItem Enabled="@svSelected" Click="ShowSVPopup" IconCssClass="oi oi-pencil" RenderStyle="ButtonRenderStyle.Info" BeginGroup="true" />
                <DxToolbarItem Enabled="@svSelected" Click="@ShowSetSVPopup" IconCssClass="bi bi-send" RenderStyle="ButtonRenderStyle.Primary" BeginGroup="true" />
                <DxToolbarItem Enabled="@svSelected" Click="ShowSVDelete" IconCssClass="oi oi-trash" RenderStyle="ButtonRenderStyle.Danger" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" />
            </DxToolbar>
        }
        
    </ToolbarTemplate>
    <Columns>
        <DxGridDataColumn FieldName="@nameof(SV.SVId)" />
        <DxGridDataColumn FieldName="@nameof(SV.Name)" />
        <DxGridDataColumn FieldName="@nameof(SV.SV_DATA_TYPE)" />
        <DxGridDataColumn FieldName="@nameof(SV.ValueString)" />
        <DxGridDataColumn FieldName="@nameof(SV.LastestUpdateTime)" DisplayFormat="G" />
    </Columns>
</DxGrid>

<DxPopup @ref="@setSVPopup" ShowCloseButton="true" CloseOnOutsideClick="false" ShowHeader="true" ShowFooter="false" Width="50rem">
    <BodyContentTemplate Context="bodycontext">
        <EditForm Model="@setSVParameter" Context="EditFormContext" OnValidSubmit="SetSV">
            <DataAnnotationsValidator />
            <DxFormLayout>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="SV Name" ColSpanLg="6" BeginRow="true">
                    <DxTextBox @bind-Text="@setSVParameter.Name" ShowValidationIcon="true" />
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Value" ColSpanLg="6" BeginRow="true">
                    <DxTextBox @bind-Text="@setSVParameter.ValueString" ShowValidationIcon="true" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanLg="12">
                    <hr />
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                    <DxToolbar>
                        <Items>
                            <DxToolbarItem IconCssClass="oi oi-check" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Primary" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />
                        </Items>
                    </DxToolbar>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditForm>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @ref="@svPopup" ShowCloseButton="true" CloseOnOutsideClick="false" ShowHeader="true" ShowFooter="false" Width="50rem">
    <BodyContentTemplate Context="bodycontext">
        <EditForm Model="@targetSV" Context="EditFormContext" OnValidSubmit="UpsertSV">
            <DataAnnotationsValidator />
            <DxFormLayout>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="SV Name" ColSpanLg="6" BeginRow="true">
                    <DxTextBox @bind-Text="@targetSV.Name" ShowValidationIcon="true" />
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="SV Id" ColSpanLg="6" BeginRow="true">
                    <DxSpinEdit @bind-Value="@targetSV.SVId" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanLg="12">
                    <hr />
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                    <DxToolbar>
                        <Items>
                            <DxToolbarItem IconCssClass="oi oi-check" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Primary" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />
                        </Items>
                    </DxToolbar>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditForm>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter]
    public bool ShowToolBar { get; set; } = false;
    IGrid? grid { get; set; }
    private List<SV> svList = new();

    private Object? targetSVObj;
    private SV? targetSV => targetSVObj as SV;
    private bool svSelected => targetSV is not null;

    DxPopup? setSVPopup { get; set; }
    SetSVParameter setSVParameter = new SetSVParameter();

    DxPopup? svPopup { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await UpdateSVValues();
        secsGemService.SVsUpdateFunc += (async () => await UpdateSVValues());
    }

    private async Task UpdateSVValues()
    {
        svList = secsGemService.SVs;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowSetSVPopup()
    {
        setSVParameter = new SetSVParameter
        {
            Name = targetSV?.Name ?? string.Empty,
        };
        await setSVPopup?.ShowAsync();
    }

    private async Task CloseSetSVPopup()
    {
        await setSVPopup?.CloseAsync();
    }

    private async Task SetSV()
    {
        await secsGemService.SetSV(setSVParameter);
        await CloseSetSVPopup();
    }


    private async Task ShowSVPopup()
    {
        await svPopup?.ShowAsync();
    }

    private async Task CloseSVPopup()
    {
        await svPopup?.CloseAsync();
    }


    private async Task NewSVClicked()
    {
        targetSVObj = new SV();
        await ShowSVPopup();
    }

    private async Task ShowSVDelete()
    {
        grid.ShowDataItemDeleteConfirmation(targetSV);
    }




    private async Task UpsertSV()
    {
        await secsGemService.UpsertSV(targetSV);
        await CloseSVPopup();
    }

    private async Task DeleteSV()
    {
        await secsGemService.DeleteSV(targetSV);
    }

    void IDisposable.Dispose()
    {
        secsGemService.SVsUpdateFunc -= (async () => await UpdateSVValues());
    }
}
