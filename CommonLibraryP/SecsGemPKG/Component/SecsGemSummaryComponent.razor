@namespace CommonLibraryP.SecsGemPKG.Component
@inject SecsGemService secsGemService
@inject NotificationService notificationService

@using QSACTIVEXLib

<DxTabs>
    <DxTabPage Text="HSMS Config" Visible="@ShowDetail">
        <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="p-3">
            <DxFormLayoutItem Visible="@ShowDetail" ColSpanLg="12">
                <DxToolbar>
                    <Items>
                        <DxToolbarItem IconCssClass="oi oi-pencil" RenderStyle="ButtonRenderStyle.Info" Click="ShowHSMSConfigPopup" />
                        <DxToolbarItem IconCssClass="oi oi-media-play" RenderStyle="ButtonRenderStyle.Success" Click="StartHSMS" BeginGroup="true" />
                        <DxToolbarItem IconCssClass="oi oi-media-stop" RenderStyle="ButtonRenderStyle.Danger" Click="StopHSMS" BeginGroup="true" />
                    </Items>
                </DxToolbar>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="12">
                <hr />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="T3" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.T3"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Device Id" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.lDeviceID"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="COMM_Mode" ColSpanLg="6">
                <DxTextBox ReadOnly="true" Text="@qsWrapper?.lCOMM_Mode.ToString()"></DxTextBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="12">
                <hr />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="T5" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.T5"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="T6" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.T6"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="T7" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.T7"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="T8" ColSpanLg="2">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.T8"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="LocalIP" ColSpanLg="3" BeginRow="true">
                <DxTextBox ReadOnly="true" Text="@qsWrapper?.szLocalIP"></DxTextBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="nLocalPort" ColSpanLg="3">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.nLocalPort"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="szRemoteIP" ColSpanLg="3">
                <DxTextBox ReadOnly="true" Text="@qsWrapper?.szRemoteIP"></DxTextBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="nRemotePort" ColSpanLg="3">
                <DxSpinEdit ReadOnly="true" Value="@qsWrapper?.nRemotePort"></DxSpinEdit>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="HSMS_COMM_MODE" ColSpanLg="6">
                <DxTextBox ReadOnly="true" Text="@qsWrapper?.HSMS_Connect_Mode.ToString()"></DxTextBox>
            </DxFormLayoutItem>
        </DxFormLayout>
    </DxTabPage>
    <DxTabPage Text="Secs">
        <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="p-3">
            <DxFormLayoutItem ColSpanLg="6" Caption="Hosting">
                <DxCheckBox Checked="@secsStatus?.Hosting" ReadOnly="true" CheckType="CheckType.Switch" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="6" Caption="Connected" BeginRow="true">
                <DxCheckBox Checked="@secsStatus?.Connected" ReadOnly="true" CheckType="CheckType.Switch" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </DxTabPage>
    <DxTabPage Text="Gem">
        <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="p-3">
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Caption="Init Success">
                <DxCheckBox Checked="@gemStatus?.InitSuccess" ReadOnly="true" CheckType="CheckType.Switch" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Horizontal" Caption="Communicating" ColSpanLg="12" BeginRow="true">
                <hr/>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Visible="@ShowDetail" Caption="Default communicating(EC7)">
                <DxCheckBox Checked="@gemStatus?.DefaultCommunicating" ReadOnly="true" CheckType="CheckType.Switch" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="Enable" Enabled="@(!gemStatus.DefaultCommunicating)" Click="(() => SwitchDefaultCommunicating(true))" RenderStyle="ButtonRenderStyle.Info" RenderStyleMode="ButtonRenderStyleMode.Outline"/>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="Disable" Enabled="@(gemStatus.DefaultCommunicating)" Click="(() => SwitchDefaultCommunicating(false))" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Caption="Communicating">
                <DxTextBox Text="@gemStatus?.CommunicatingString" ReadOnly="true" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="Enable" Enabled="@(!gemStatus.AllowCommunicating)" Click="(() => SwitchCommunicating(true))" RenderStyle="ButtonRenderStyle.Info" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="Disable" Enabled="@(gemStatus.AllowCommunicating)" Click="(() => SwitchCommunicating(false))" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Horizontal" ColSpanLg="12" Caption="Control" BeginRow="true">
                <hr />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Caption="Control State(SV4)">
                <DxTextBox Text="@gemStatus?.ControlStateString" ReadOnly="true" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxDropDownButton  Text="Online" RenderStyle="ButtonRenderStyle.Info" RenderStyleMode="ButtonRenderStyleMode.Outline">
                    <Items>
                        <DxDropDownButtonItem Text="Request" Click="SendOnLineRequest" Enabled="@canSendOnLineRequest" />
                        <DxDropDownButtonItem Text="Romote" Click="SendOnLineRemote" Enabled="@canSendOnLineRemote" />
                        <DxDropDownButtonItem Text="Local" Click="SendOnLineLocal" Enabled="@canSendOnLineLocal"/>
                    </Items>
                </DxDropDownButton>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="OffLine" Click="SendOffLine" Enabled="@canSendOffLine" RenderStyle="ButtonRenderStyle.Warning" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Visible="@ShowDetail" Caption="Default Control State(EC8)" BeginRow="true">
                <DxTextBox Text="@gemStatus?.DefaultControlStateString" ReadOnly="true"/>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="On Line" Enabled="@(gemStatus.DefaultControlState is not DefaultControlState.OnLine)" Click="(() => SwitchDefaultControlState(DefaultControlState.OnLine))" RenderStyle="ButtonRenderStyle.Info" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@(gemBtnColSpan / 2)" Visible="@ShowDetail">
                <DxButton Text="Off Line" Enabled="@(gemStatus.DefaultControlState is not DefaultControlState.OffLine)" Click="(() => SwitchDefaultControlState(DefaultControlState.OffLine))" RenderStyle="ButtonRenderStyle.Warning" RenderStyleMode="ButtonRenderStyleMode.Outline" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Visible="@ShowDetail" Caption="Default Offline Substate(EC49)">
                <DxTextBox Text="@gemStatus?.DefaultOfflineSubstateString" ReadOnly="true" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemBtnColSpan" Visible="@ShowDetail">
                <DxButtonGroup RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="@ButtonRenderStyleMode.Outline">
                    <Items>
                        <DxButtonGroupItem Text="Eqp Offline" Enabled="@(gemStatus.DefaultOfflineSubstate is not DefaultOfflineOrOnlineFailSubstate.EqpOffLine)" Click="(() => SwitchDefaultOfflineSubstate(DefaultOfflineOrOnlineFailSubstate.EqpOffLine))" />
                        <DxButtonGroupItem Text="Attempt Online" Enabled="@(gemStatus.DefaultOfflineSubstate is not DefaultOfflineOrOnlineFailSubstate.AttemptOnLine)" Click="(() => SwitchDefaultOfflineSubstate(DefaultOfflineOrOnlineFailSubstate.AttemptOnLine))" />
                        <DxButtonGroupItem Text="Host Offline" Enabled="@(gemStatus.DefaultOfflineSubstate is not DefaultOfflineOrOnlineFailSubstate.HostOffLine)" Click="(() => SwitchDefaultOfflineSubstate(DefaultOfflineOrOnlineFailSubstate.HostOffLine))" />
                    </Items>
                </DxButtonGroup>
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Visible="@ShowDetail" Caption="Default Online Fail Substate(EC50)">
                <DxTextBox Text="@gemStatus?.DefaultOnlineFailSubstateString" ReadOnly="true" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemBtnColSpan" Visible="@ShowDetail">
                <DxButtonGroup RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="@ButtonRenderStyleMode.Outline">
                    <Items>
                        <DxButtonGroupItem Text="Eqp Offline" Enabled="@(gemStatus.DefaultOnlineFailSubstate is not DefaultOfflineOrOnlineFailSubstate.EqpOffLine)" Click="(() => SwitchDefaultOnlineFailSubstate(DefaultOfflineOrOnlineFailSubstate.EqpOffLine))" />
                        <DxButtonGroupItem Text="Host Offline" Enabled="@(gemStatus.DefaultOnlineFailSubstate is not DefaultOfflineOrOnlineFailSubstate.HostOffLine)" Click="(() => SwitchDefaultOnlineFailSubstate(DefaultOfflineOrOnlineFailSubstate.HostOffLine))" />
                    </Items>
                </DxButtonGroup>
            </DxFormLayoutItem>

            <DxFormLayoutItem ColSpanLg="@gemDataColSpan" Caption="Default Online Substate(EC51)" Visible="@ShowDetail">
                <DxTextBox Text="@gemStatus?.DefaultOnlineSubstateString" ReadOnly="true" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanLg="@gemBtnColSpan" Visible="@ShowDetail">
                <DxButtonGroup RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="@ButtonRenderStyleMode.Outline">
                    <Items>
                        <DxButtonGroupItem Text="Remote" Enabled="@(gemStatus.DefaultOnlineSubstate is not DefaultOnlineSubstate.Remote)" Click="(() => SwitchDefaultOnlineSubstate(DefaultOnlineSubstate.Remote))" />
                        <DxButtonGroupItem Text="Local" Enabled="@(gemStatus.DefaultOnlineSubstate is not DefaultOnlineSubstate.Local)" Click="(() => SwitchDefaultOnlineSubstate(DefaultOnlineSubstate.Local))" />
                    </Items>
                </DxButtonGroup>
            </DxFormLayoutItem>
        </DxFormLayout>
    </DxTabPage>
</DxTabs>

<DxPopup @ref="@hsmsPopup" ShowCloseButton="true" CloseOnOutsideClick="false" ShowHeader="true" ShowFooter="false" Width="50rem">
    <BodyContentTemplate Context="bodycontext">
        <EditForm Model="@hsmsParameter" Context="EditFormContext" OnValidSubmit="UpsertHSMSConfig">
            <DataAnnotationsValidator />
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                <DxFormLayoutItem Caption="T3" ColSpanLg="3">
                    <DxSpinEdit @bind-Value="@hsmsParameter.T3"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Device Id" ColSpanLg="3">
                    <DxSpinEdit @bind-Value="@hsmsParameter.DeviceID"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="COMM_Mode" ColSpanLg="6">
                    <DxComboBox @bind-Value="@hsmsParameter.CommMode" Data="@commmodeTypeWrapperClasses" TextFieldName="@nameof(COMMMODETypeWrapperClass.DisplayName)" ValueFieldName="@nameof(COMMMODETypeWrapperClass.Commmode)" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanLg="12">
                    <hr />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="T5" ColSpanLg="2">
                    <DxSpinEdit @bind-Value="@hsmsParameter.T5"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="T6" ColSpanLg="2">
                    <DxSpinEdit @bind-Value="@hsmsParameter.T6"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="T7" ColSpanLg="2">
                    <DxSpinEdit @bind-Value="@hsmsParameter.T7"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="T8" ColSpanLg="2">
                    <DxSpinEdit @bind-Value="@hsmsParameter.T8"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="LocalIP" ColSpanLg="3" BeginRow="true">
                    <DxTextBox @bind-Text="@hsmsParameter.LocalIP"></DxTextBox>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="LocalPort" ColSpanLg="3">
                    <DxSpinEdit @bind-Value="@hsmsParameter.LocalPort"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="RemoteIP" ColSpanLg="3">
                    <DxTextBox @bind-Text="@hsmsParameter.RemoteIP"></DxTextBox>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="RemotePort" ColSpanLg="3">
                    <DxSpinEdit @bind-Value="@hsmsParameter.RemotePort"></DxSpinEdit>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="HSMS_COMM_MODE" ColSpanLg="6">
                    <DxComboBox @bind-Value="@hsmsParameter.HSMS_Connect_Mode" Data="@hsmsCOMMMODETypeWrapperClasses" TextFieldName="@nameof(HSMSCOMMMODETypeWrapperClass.DisplayName)" ValueFieldName="@nameof(HSMSCOMMMODETypeWrapperClass.HSMS_COMM_MODE)" />
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanLg="12">
                    <hr />
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                    <DxToolbar>
                        <Items>
                            <DxToolbarItem IconCssClass="oi oi-check" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Primary" BeginGroup="true" Alignment="ToolbarItemAlignment.Right" RenderStyleMode="ToolbarItemRenderStyleMode.Contained" />
                        </Items>
                    </DxToolbar>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditForm>
    </BodyContentTemplate>
</DxPopup>

@code {

    [Parameter]
    public bool ShowDetail { get; set; } = true;

    private DxPopup? hsmsPopup { get; set; }
    private HSMSParameter hsmsParameter = new();
    private IEnumerable<COMMMODETypeWrapperClass> commmodeTypeWrapperClasses => SecsGemTypeEnumHelper.CommmodeTypeWrapperClasses();
    private IEnumerable<HSMSCOMMMODETypeWrapperClass> hsmsCOMMMODETypeWrapperClasses => SecsGemTypeEnumHelper.HsmsCommmodeTypeWrapperClasses();

    private int gemDataColSpan = 4;
    private int gemBtnColSpan => 12 - gemDataColSpan;
    private SECSStatus? secsStatus;
    private GemStatus? gemStatus;
    private bool hasGemStatus => gemStatus is not null;
    private QSWrapper? qsWrapper;

    private bool canSendOnLineRequest => hasGemStatus && gemStatus.ControlState is ControlState.OffLine_EQPOffline;
    private bool canSendOffLine => hasGemStatus && (gemStatus.ControlState is ControlState.OffLine_HostOffline || gemStatus.ControlState is ControlState.OnLine_Local || gemStatus.ControlState is ControlState.OnLine_Remote);
    private bool canSendOnLineRemote => hasGemStatus && gemStatus.ControlState is ControlState.OnLine_Local;
    private bool canSendOnLineLocal => hasGemStatus && gemStatus.ControlState is ControlState.OnLine_Remote;


    private string hostingBtnText => secsStatus is not null && secsStatus.Hosting ? "Disable" : "Enable";

    private ButtonRenderStyle communicatingRenderStyle => gemStatus is not null && gemStatus.AllowCommunicating ? ButtonRenderStyle.Danger : ButtonRenderStyle.Success;
    private string communicatingBtnText => gemStatus is not null && gemStatus.AllowCommunicating ? "Disable" : "Enable";

    protected override async Task OnInitializedAsync()
    {
        await QSConfigUpdate();
        secsGemService.HSMSConfigAct += (async () => await QSConfigUpdate());


        secsStatus = secsGemService.SECSStatus;
        secsStatus.SECSUpdateFunc += StatusUpdate;

        gemStatus = secsGemService.GemStatus;
        gemStatus.GemUpdateFunc += StatusUpdate;

        await base.OnInitializedAsync();
    }

    private async Task QSConfigUpdate()
    {
        qsWrapper = secsGemService.QSWrapper;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StatusUpdate()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowHSMSConfigPopup()
    {
        hsmsParameter = await secsGemService.GetHSMSParameter() ?? new();
        await hsmsPopup?.ShowAsync();
    }
    private async Task CloseHSMSConfigPopup()
    {
        await hsmsPopup?.CloseAsync();
    }

    private async Task UpsertHSMSConfig()
    {
        var res = await secsGemService.UpsertHSMSParameter(hsmsParameter);
        await CloseHSMSConfigPopup();
        notificationService.ShowToast(res);
    }

    private async Task StartHSMS()
    {
        var res = await secsGemService.InitAndStartHSMS();
        notificationService.ShowToast(res);
    }
    private async Task StopHSMS()
    {
        var res = secsGemService.StopHSMS();
        notificationService.ShowToast(res);
    }


    private void SwitchCommunicating(bool b)
    {
        secsGemService.SwitchGemCommunicatingStatus(b);
    }

    private async Task SwitchDefaultCommunicating(bool b)
    {
        var res = await secsGemService.SwitchDefaultCommunicatingStatus(b);
        notificationService.ShowToast(res);
    }

    private async Task SendOnLineRequest()
    {
        var res = await secsGemService.SendOnlineRequest();
        notificationService.ShowToast(res);
    }

    private async Task SendOffLine()
    {
        var res = await secsGemService.SendOffline();
        notificationService.ShowToast(res);
    }

    private async Task SendOnLineRemote()
    {
        var res = await secsGemService.SendOnLineRemote();
        notificationService.ShowToast(res);
    }

    private async Task SendOnLineLocal()
    {
        var res = await secsGemService.SendOnLineLocal();
        notificationService.ShowToast(res);
    }

    private async Task SwitchDefaultControlState(DefaultControlState state)
    {
        var res = await secsGemService.SwitchDefaultControlState(state);
        notificationService.ShowToast(res);
    }

    private async Task SwitchDefaultOfflineSubstate(DefaultOfflineOrOnlineFailSubstate state)
    {
        var res = await secsGemService.SwitchDefaultOfflineSubstate(state);
        notificationService.ShowToast(res);
    }

    private async Task SwitchDefaultOnlineFailSubstate(DefaultOfflineOrOnlineFailSubstate state)
    {
        var res = await secsGemService.SwitchDefaultOnlineFailSubstate(state);
        notificationService.ShowToast(res);
    }

    private async Task SwitchDefaultOnlineSubstate(DefaultOnlineSubstate defaultOnlineSubstate)
    {
        var res = await secsGemService.SwitchDefaultOnlineSubstate(defaultOnlineSubstate);
        notificationService.ShowToast(res);
    }
}
