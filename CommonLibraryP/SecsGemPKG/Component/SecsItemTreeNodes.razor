@namespace CommonLibraryP.SecsGemPKG.Component
@rendermode RenderMode.InteractiveServer
@using CommonLibraryP.SecsGemPKG

<DxTreeViewNode Text="@(SecsItem.Id.ToString())">
    <Nodes>
        @if (SecsItem is SecsList secsList)
        {
            foreach (var item in secsList.ChildrenNode)
            {
                <CascadingValue Value="item">
                    <SecsItemTreeNodes />
                </CascadingValue>

@*                 <SecsItemTreeNodes SecsItem="@item"></SecsItemTreeNodes>
 *@            }
        }
    </Nodes>
</DxTreeViewNode>

@code {
    [CascadingParameter]
    public SecsTreeNode SecsItem { get; set; } = null!;

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }
}
