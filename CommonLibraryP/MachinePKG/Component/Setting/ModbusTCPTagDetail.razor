@namespace CommonLibraryP.MachinePKG.Component

@rendermode RenderMode.InteractiveServer
@inject IStringLocalizer<MachineLanguage> localizer

@inject MachineService machineService

<DxFormLayout Data="@ModbusTCPTagParam" ReadOnly="true" CaptionPosition="CaptionPosition.Vertical">
    <DxFormLayoutItem Field="@nameof(ModbusTCPTag.Station)" Caption="@($"{localizer["Station"]}")" ColSpanLg="2"/>
    <DxFormLayoutItem Field="@nameof(ModbusTCPTag.InputOrOutput)" Caption="@($"{localizer["Input/Output"]}")" ColSpanLg="2">
        <DxCheckBox CheckType="CheckType.Switch" ReadOnly="true" Checked="@(ModbusTCPTagParam.InputOrOutput)"/>
    </DxFormLayoutItem>
    <DxFormLayoutItem Field="@nameof(ModbusTCPTag.StartIndex)" Caption="@($"{localizer["Start Index"]}")" ColSpanLg="3" />
    <DxFormLayoutItem Field="@nameof(ModbusTCPTag.Offset)" Caption="@($"{localizer["Offset"]}")" ColSpanLg="3" />
    <DxFormLayoutItem Field="@nameof(ModbusTCPTag.StringReverse)" Caption="@($"{localizer["String Reverse"]}")" ColSpanLg="2">
        <DxCheckBox CheckType="CheckType.Switch" ReadOnly="true" Checked="@(ModbusTCPTagParam.StringReverse)" />
    </DxFormLayoutItem>
</DxFormLayout>

@code {
    [Parameter]
    public ModbusTCPTag ModbusTCPTagParam { get; set; } = null!;
}
