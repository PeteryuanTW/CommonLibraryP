@namespace CommonLibraryP.MapPKG
@inject IStringLocalizer<MapLanguage> localizer


@if (hasMapComponent)
{
    <DxFormLayoutGroup Caption="@(localizer["Component Info"])" ReadOnly="true">
        <DxFormLayoutItem Caption="@(localizer["X Position"])" Field="@nameof(MapComponent.PositionX)">
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(localizer["Y Position"])" Field="@nameof(MapComponent.PositionY)">
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(localizer["Height"])" Field="@nameof(MapComponent.Height)">
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(localizer["Width"])" Field="@nameof(MapComponent.Width)">
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

}

@code {
    [Parameter]
    public MapComponent? MapComponentParam { get; set; }

    private bool hasMapComponent => MapComponentParam != null;
}
