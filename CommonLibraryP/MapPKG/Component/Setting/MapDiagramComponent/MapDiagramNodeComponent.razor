@namespace CommonLibraryP.MapPKG

@using Blazor.Diagrams.Components.Renderers;

<style>
    .nodecomponent {
        background-color: rgba(173, 216, 230, 0.8);
        outline: 1px solid black;
        padding: 20px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
    }
</style>

<div id="@Node.MapComponent.Id" class="nodecomponent rounded" style="@($"width:{Node.WidthInMap}px; height:{Node.HeightInMap}px")">
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" />
    }
    <img src="@IconRoute" style="width: 100%; height: 100%; object-fit: contain;pointer-events: none;" />
</div>

@code {
    [Parameter]
    public MapDiagramNode Node { get; set; } = null!;

    public string IconRoute =>
    Node.MapComponent switch
    {
        MapComponentMachine mapComponentMachine => "_content/CommonLibraryP/SVG/MachineIcons/robot.svg",
        MapComponentStation mapComponentStation => "_content/CommonLibraryP/SVG/ShopfloorIcons/station.svg",
        _ => "_content/CommonLibraryP/SVG/CommonIcons/question.svg"
    };


}
