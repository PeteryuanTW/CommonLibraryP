@namespace CommonLibraryP.UserPKG.Component
@inject IStringLocalizer<UserLanguage> localizer
@rendermode RenderMode.InteractiveServer

@inherits AuthComponentBase

@inject NavigationManager nav
@inject NotificationService notificationService


<DxGridLayout>
    <Rows>
        <DxGridLayoutRow Height="4fr"/>
        <DxGridLayoutRow Height="4fr" />
        <DxGridLayoutRow Height="4fr" />
    </Rows>
    <Columns>
        <DxGridLayoutColumn Width="4fr"/>
        <DxGridLayoutColumn Width="4fr" />
        <DxGridLayoutColumn Width="4fr" />
    </Columns>
    <Items>
        <DxGridLayoutItem Row="1" Column="1">
            <Template>
                <div class="card p-5">
                    @if (!userService.IsPorcossing)
                    {
                        @if (userService.IsAuth)
                        {
                            <DxFormLayout>
                                <DxFormLayoutItem Caption="@(localizer["Id"])" CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12" BeginRow="true">
                                    <DxTextBox Text="@userService.UserInfoDTO?.Id.ToString()" ReadOnly="true" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@(localizer["User Name"])" CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12" BeginRow="true">
                                    <DxTextBox Text="@userService.UserInfoDTO?.Username" ReadOnly="true" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@(localizer["Role"])" CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12" BeginRow="true">
                                    <DxTextBox Text="@userService.UserInfoDTO?.Role.ToString()" ReadOnly="true" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <DxButton Text="Logout" Click="LogoutAsync" RenderStyle="ButtonRenderStyle.Danger" />
                                    </div>
                                </DxFormLayoutItem>
                            </DxFormLayout>
                        }
                        else
                        {
                            <EditForm Model="@userLoginDTO" Context="EditFormContext" OnValidSubmit="LoginAsync">
                                <DataAnnotationsValidator />
                                <DxFormLayout>
                                    <DxFormLayoutItem Caption="@(localizer["User Name"])" CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12" BeginRow="true">
                                        <DxTextBox @bind-Text="@userLoginDTO.UserName" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="@(localizer["Password"])" CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                                        <DxTextBox @bind-Text="@userLoginDTO.Password" Password="true" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanLg="12">
                                        <div class="d-flex justify-content-center align-items-center">
                                            <DxButton Text="Login" SubmitFormOnClick="true" RenderStyle="ButtonRenderStyle.Info" />
                                        </div>
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </EditForm>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center">
                            <DxWaitIndicator Visible="true" AnimationType="WaitIndicatorAnimationType.Pulse" />
                        </div>
                    }
                </div>
            </Template>
        </DxGridLayoutItem>
    </Items>
</DxGridLayout>
@code {
    private UserLoginDTO userLoginDTO = new();

    private bool showPassword = false;

    private async Task LoginAsync()
    {
        var res = await userService.LoginAsync(userLoginDTO);
        if (res.IsSuccess)
        {
            nav.NavigateTo("/", true);
        }
        else
        {
            notificationService.ShowToast(res);
        }

    }

    private async Task LogoutAsync()
    {
        var res = await userService.LogoutAsync();
        notificationService.ShowToast(res);
        nav.NavigateTo("/", true);
    }
}
