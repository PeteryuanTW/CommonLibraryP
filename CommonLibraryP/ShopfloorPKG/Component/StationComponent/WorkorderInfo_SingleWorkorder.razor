@namespace CommonLibraryP.ShopfloorPKG.Component

@inject IStringLocalizer<ShopfloorLanguage> localizer
@inherits WorkorderInfoComponent

@if (StationParamFromRoot is not null)
{
    <DxFormLayout>
        <DxFormLayoutItem Caption="@($"{localizer["Workorder No"]}")" CaptionPosition="CaptionPosition.Vertical">
            <DxTextBox Text="@stationSingleWorkorder?.Workorder?.WorkorderNo" ReadOnly="true" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{localizer["Lot"]}")" CaptionPosition="CaptionPosition.Vertical">
            <DxTextBox Text="@stationSingleWorkorder?.Workorder?.Lot" ReadOnly="true" />
        </DxFormLayoutItem>
    </DxFormLayout>
}


@code {
    private StationSingleWorkorder? stationSingleWorkorder => StationParamFromRoot as StationSingleWorkorder;
}
