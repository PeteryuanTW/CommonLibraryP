@namespace CommonLibraryP.ShopfloorPKG.Component

@inherits WorkorderInfoComponent
@inject IStringLocalizer<ShopfloorLanguage> localizer

@if (stationSingleWorkorderSingleSerial is not null)
{
    <DxFormLayout>
        <DxFormLayoutItem Caption="@($"{localizer["Serial no"]}")" ColSpanLg="12" CaptionPosition="CaptionPosition.Vertical">
            <DxTextBox Text="@stationSingleWorkorderSingleSerial?.WIPItemDetail?.SerialNo" ReadOnly="true" />
        </DxFormLayoutItem><DxFormLayoutItem Caption="@($"{localizer["Start time"]}")" ColSpanLg="12" CaptionPosition="CaptionPosition.Vertical">
            <DxDateEdit Date="@stationSingleWorkorderSingleSerial?.WIPTaskDetail?.StartTime" ReadOnly="true" DisplayFormat="G" />
        </DxFormLayoutItem>
    </DxFormLayout>
}
else
{

}

@code {

    private StationSingleWorkorderSingleSerial stationSingleWorkorderSingleSerial => StationParamFromRoot as StationSingleWorkorderSingleSerial;

}
